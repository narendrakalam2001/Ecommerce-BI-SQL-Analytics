# ============================================================
# .gitignore — E-Commerce BI & SQL Analytics
# ============================================================
# Rule of thumb: anything needed to BUILD or DEPLOY the project is
# pushed. Anything that gets auto-GENERATED by running the project
# is ignored (rebuilds locally/on-deploy in seconds anyway).
# ============================================================

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
.env

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Full raw Kaggle dataset (~180MB, download separately — see README) ---
# NOTE: data/sample/ is intentionally NOT ignored — those files ARE
# pushed, since Render + Streamlit Cloud both build their database
# from data/sample/ at deploy time (see src/config.py RAW_DATA_DIR
# fallback and render.yaml buildCommand).
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/processed/*

# --- Generated artifacts (rebuilt automatically by build_database.py /
#     run_pipeline.py, both locally and on every deploy — never push) ---
artifacts/*.db
artifacts/*.json
!logs/*.csv

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Notebook-generated outputs (only the .ipynb + .html deliverables
#     are pushed from notebooks/ — any working-directory output folders
#     the notebook writes to when run, e.g. exported mart CSVs or a
#     scratch DB, are regenerated on re-run and never pushed) ---
notebooks/olist_outputs/
notebooks/*_outputs/
notebooks/output/